# Keep your real existing .env; this is only a reference.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/farmdirect
SECRET_KEY=
# Generate using: python -c "import secrets; print(secrets.token_urlsafe(48))"
RESERVATION_HOURS=24
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Your frontend origin, if it runs on a different host/port:
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:5500
# Identify your app and provide a real contact when using the public geocoder:
MAP_USER_AGENT=FarmDirect/2.0 (replace with your project contact URL)
